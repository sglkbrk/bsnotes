# ==========================================
# BSNOTES ORTAM DEĞİŞKENLERİ (.env)
# ==========================================

# Portlar
FRONTEND_PORT=3002
BACKEND_PORT=5002

# Frontend Build Sırasında Kullanılacak API URL
# Sunucuda: https://bsnote.buraksaglik.com/api/
# Lokalde: http://localhost:5002/api/
REACT_APP_API_URL=https://bsnote.buraksaglik.com/api/

# MySQL Veritabanı Bağlantısı (Prisma)
# Format: mysql://KULLANICI:SIFRE@HOST:PORT/VERITABANI_ADI
DATABASE_URL="mysql://Localhost:1234567@localhost:3306/BsNotesDb"

# JWT Yapılandırması (.NET BsNotesServices ile tam uyumlu)
JWT_KEY="BurakSaglikSuperSecretKeyForBsNotes2024!"
JWT_ISSUER="BsNotesServices"
JWT_AUDIENCE="BsNotesClient"
JWT_EXPIRES_IN="30d"

# Ortam Modu (production / development)
NODE_ENV=production

